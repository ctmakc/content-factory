# Content Factory Configuration

# Application
APP_NAME="Content Factory"
DEBUG=false

# Database (SQLite for MVP, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./content_factory.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/content_factory"

# AI Provider: "openai" or "anthropic"
AI_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY="sk-your-openai-key-here"
OPENAI_MODEL="gpt-3.5-turbo"

# Anthropic Configuration
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# LinkedIn OAuth (optional for automated posting)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Twitter/X API (optional for automated posting)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""

# Default settings for Crystal Tax use case
DEFAULT_NICHE="offshore company registration"
DEFAULT_TONE="professional, trustworthy, educational"
